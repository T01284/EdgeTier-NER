# LDC / Reuters-attached corpora — do not redistribute processed splits
data/processed_remote/ontonotes/
data/processed_remote/conll2003/

# Scratch operator scripts (local GPU/ops only; never publish)
scripts/_*.py
scripts/_*.sh
scripts/_*.log

# Training runs — pin the CoNLL deploy checkpoint used for Table 5 (fulltestb s42)
outputs/runs/*
!outputs/runs/conll2003_full_fulltestb_s42/
outputs/runs/conll2003_full_fulltestb_s42/*
!outputs/runs/conll2003_full_fulltestb_s42/best.pt
!outputs/runs/conll2003_full_fulltestb_s42/metrics.json
!outputs/runs/conll2003_full_fulltestb_s42/char_vocab.json

# Export bundles — pin the same s42 deploy path as Pi assets
outputs/export/*
!outputs/export/conll2003_full_fulltestb_s42/
!outputs/export/conll2003_full_fulltestb_s42/**
outputs/export_test/
outputs/logs/

# Model binaries — global ignore with deploy/export exceptions
*.pt
!outputs/runs/conll2003_full_fulltestb_s42/best.pt
*.pth
*.onnx
!deploy/esp32-s3/models/*.onnx
!deploy/pi3b/assets/deploy/*.onnx
!outputs/export/conll2003_full_fulltestb_s42/deploy/*.onnx
*.espdl
!deploy/esp32-s3/models/*.espdl

# Probe / intermediate MCU exports (not the paper identity-skip SKU)
